# Environment variables for docker-compose.dokploy.yml.
#
# Set these in the Dokploy project's "Environment" tab. Do NOT commit a real
# .env.dokploy file. This is a reference of every variable the stack needs.

# Postgres: configures the container and builds DATABASE_URL for the app
POSTGRES_DB=plan_generator
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Public URL of the app, for example https://plans.example.com
# Used for sign-in callbacks and trusted origins. Must be the exact public URL the proxy serves
BETTER_AUTH_URL=https://your-domain.example.com

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# openssl rand -base64 32
# Losing this key makes every saved AI key unreadable. Back it up.
ENCRYPTION_KEY=

# Optional sign-in providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional verification and password reset emails
RESEND_API_KEY=
EMAIL_FROM=

# Optional usage limits
LIMIT_AI_PER_HOUR=30
LIMIT_PLANS_PER_USER=50
LIMIT_CHAT_CHARS=2000
