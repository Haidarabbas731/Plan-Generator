# Dev image: includes dev dependencies and runs the Vite dev server.
# Used by docker-compose.yml for local development only.
# Production uses Dockerfile (multi-stage, production dependencies only).

FROM oven/bun:1.4.2-debian

WORKDIR /app

RUN groupadd -g 1001 appgroup && useradd -u 1001 -g appgroup -m -s /bin/bash appuser

# Copy dependency files first to maximize Docker layer caching
COPY package.json bun.lock ./

RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun install --frozen-lockfile

COPY --chown=appuser:appgroup . .

RUN chown -R appuser:appgroup /app

USER appuser

EXPOSE 5173

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD bun -e "fetch('http://localhost:5173/').then((r) => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["bun", "run", "dev", "--host", "0.0.0.0"]
